{
    "name": "sergio-asensio-cv-app",
    "version": "2.3.0",
    "scripts": {
        "ng": "ng",
        "build": "ng build",
        "prestart": "npm run lint && npm run build --env=%npm_config_env%",
        "start": "node --max_old_space_size=8192 node_modules/@angular/cli/bin/ng serve --configuration %npm_config_env%",
        "start:local": "node --max_old_space_size=8192 node_modules/@angular/cli/bin/ng serve --configuration %npm_config_env%",
        "watch": "ng build --watch --configuration %npm_config_env%",
        "test": "ng test",
        "test:coverage": "ng test --watch=false --code-coverage",
        "dockerize": "docker-compose -f docker-compose.yml -f docker/docker-compose.%npm_config_env%.yml  --profile %npm_config_service% up --build -d",
        "lint": "eslint .",
        "lint-fix": "eslint . --fix",
        "format": "prettier --write ."
    },
    "overrides": {
        "vite": "7.3.2"
    },
    "private": true,
    "dependencies": {
        "@angular-devkit/build-angular": "^21.2.6",
        "@angular/animations": "^21.2.7",
        "@angular/cdk": "^21.2.5",
        "@angular/cli": "^21.2.6",
        "@angular/common": "^21.2.7",
        "@angular/compiler": "^21.2.7",
        "@angular/compiler-cli": "^21.2.7",
        "@angular/core": "^21.2.7",
        "@angular/forms": "^21.2.7",
        "@angular/material": "^21.2.5",
        "@angular/platform-browser": "^21.2.7",
        "@angular/platform-browser-dynamic": "^21.2.7",
        "@angular/router": "^21.2.7",
        "@fortawesome/fontawesome-free": "^7.2.0",
        "@ngrx/effects": "^21.1.0",
        "@ngrx/store": "^21.1.0",
        "@ngrx/store-devtools": "^21.1.0",
        "@ngx-translate/core": "^17.0.0",
        "@ngx-translate/http-loader": "^17.0.0",
        "@types/node": "^25.5.2",
        "bootstrap": "^5.3.8",
        "flag-icons": "^7.5.0",
        "rxjs": "~7.8.2",
        "tslib": "^2.8.1",
        "zone.js": "~0.16.1"
    },
    "devDependencies": {
        "@redux-devtools/extension": "^4.0.0",
        "@types/jasmine": "~6.0.0",
        "@typescript-eslint/eslint-plugin": "^8.58.0",
        "@typescript-eslint/parser": "^8.58.0",
        "eslint": "^9.39.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.5",
        "jasmine-core": "~6.1.0",
        "karma": "~6.4.4",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.1",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.2.0",
        "prettier": "^3.8.1",
        "typescript": "~5.9.3"
    }
}
